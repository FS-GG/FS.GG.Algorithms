<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiled only by Fable (bench/run.sh): the shared workloads as a JavaScript module for bench/fable/run.mjs.
       Never shipped. Not in the solution. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../shared/Workloads.fs" Link="Workloads.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/FS.GG.Algorithms/FS.GG.Algorithms.fsproj" />
  </ItemGroup>

</Project>
